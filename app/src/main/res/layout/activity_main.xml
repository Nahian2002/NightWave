<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:fitsSystemWindows="true" android:background="#0B0D0F">
    <LinearLayout android:id="@+id/topSearchArea" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="13dp"
        android:paddingBottom="12dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="38dp" android:layout_height="38dp"
                android:src="@drawable/ic_nightwave" android:contentDescription="NightWave logo" />
            <TextView android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:layout_marginStart="10dp"
                android:text="NightWave" android:textColor="#F3F6F3" android:textSize="23sp"
                android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SCREEN-OFF MUSIC" android:textSize="10sp" android:textStyle="bold"
                android:textColor="#B2F369" android:letterSpacing="0.08" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="16dp" android:orientation="horizontal" android:gravity="center_vertical">
            <EditText android:id="@+id/searchBox" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="match_parent"
                android:paddingStart="17dp" android:paddingEnd="12dp"
                android:background="@drawable/bg_search" android:singleLine="true"
                android:hint="Search songs, artists, videos" android:textColor="#F4F6F4"
                android:textColorHint="#97A29A" android:textSize="15sp"
                android:imeOptions="actionSearch" android:inputType="text|textAutoCorrect"
                android:drawableStart="@android:drawable/ic_menu_search" android:drawablePadding="8dp" />
            <TextView android:id="@+id/searchButton" android:layout_width="76dp"
                android:layout_height="match_parent" android:layout_marginStart="9dp"
                android:background="@drawable/bg_action" android:gravity="center"
                android:text="SEARCH" android:textColor="#111911"
                android:textSize="12sp" android:textStyle="bold"
                android:clickable="true" android:focusable="true" android:contentDescription="Search YouTube" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="15dp" android:gravity="center_vertical">
            <TextView android:id="@+id/songsChip" android:layout_width="wrap_content"
                android:layout_height="38dp" android:minWidth="88dp" android:gravity="center"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:background="@drawable/bg_chip_selected" android:text="Songs"
                android:textSize="13sp" android:textStyle="bold" android:textColor="#0B0D0F"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/videosChip" android:layout_width="wrap_content"
                android:layout_height="38dp" android:minWidth="88dp" android:gravity="center"
                android:layout_marginStart="9dp" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:background="@drawable/bg_chip_normal" android:text="Videos"
                android:textSize="13sp" android:textStyle="bold" android:textColor="#F3F6F3"
                android:clickable="true" android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22282A" />
    <ScrollView android:id="@+id/resultsScroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"
        android:clipToPadding="false" android:focusableInTouchMode="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp"
            android:paddingTop="17dp" android:paddingBottom="24dp">
            <TextView android:id="@+id/resultsHeading" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Find your next favorite song"
                android:textSize="19sp" android:textStyle="bold" android:textColor="#F3F6F3" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
                <ProgressBar android:id="@+id/searchProgress" style="?android:attr/progressBarStyleSmall"
                    android:layout_width="23dp" android:layout_height="23dp" android:visibility="gone"
                    android:indeterminateTint="#B2F369" />
                <TextView android:id="@+id/statusText" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="2dp" android:text="Type a song name above and press Search."
                    android:textColor="#A7B2AB" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/resultsContainer" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/playerPanel" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp" android:layout_marginBottom="12dp"
        android:orientation="vertical" android:background="@drawable/bg_player"
        android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="13dp"
        android:paddingBottom="10dp" android:visibility="gone">
        <TextView android:id="@+id/currentTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#F1F6EA"
            android:textSize="14sp" android:textStyle="bold" android:maxLines="1"
            android:ellipsize="end" android:text="Not playing"/>
        <TextView android:id="@+id/currentCreator" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="3dp"
            android:textColor="#AABBA4" android:textSize="11sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <TextView android:id="@+id/favoriteButton" android:layout_width="44dp"
                android:layout_height="42dp" android:gravity="center" android:text="♡"
                android:textColor="#F4F6F4" android:textSize="28sp"
                android:clickable="true" android:focusable="true" android:contentDescription="Like current song" />
            <TextView android:id="@+id/playlistButton" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="42dp" android:gravity="center"
                android:text="+ Playlist" android:textColor="#B2F369" android:textSize="13sp"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/queueButton" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="42dp" android:gravity="center"
                android:text="≡ Queue" android:textColor="#F2F6F2" android:textSize="13sp"
                android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/nowPlayingButton" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="42dp" android:gravity="center"
                android:text="NOW PLAYING ↗" android:textColor="#F2F6F2"
                android:textStyle="bold" android:textSize="11sp"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>
        <SeekBar android:id="@+id/progress" android:layout_width="match_parent"
            android:layout_height="29dp" android:layout_marginTop="4dp"
            android:max="1000" android:progressTint="#B2F369" android:thumbTint="#B2F369"
            android:progressBackgroundTint="#3D4F41"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/timeText" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="0:00 / 0:00"
                android:textColor="#B9C9B1" android:textSize="11sp" />
            <TextView android:id="@+id/shuffleButton" android:layout_width="40dp"
                android:layout_height="44dp" android:gravity="center" android:text="⇄"
                android:textColor="#B9C9B1" android:textSize="22sp"
                android:clickable="true" android:focusable="true" android:contentDescription="Toggle shuffle" />
            <TextView android:id="@+id/prevTrackButton" android:layout_width="38dp"
                android:layout_height="44dp" android:gravity="center" android:text="|◀"
                android:textColor="#F3F6F3" android:textSize="17sp"
                android:clickable="true" android:focusable="true" android:contentDescription="Previous song" />
            <TextView android:id="@+id/backButton" android:layout_width="46dp"
                android:layout_height="44dp" android:gravity="center" android:text="↶15"
                android:textColor="#ECF5E9" android:textSize="15sp"/>
            <TextView android:id="@+id/toggleButton" android:layout_width="54dp"
                android:layout_height="46dp" android:gravity="center" android:text="▶"
                android:textColor="#B2F369" android:textSize="25sp"/>
            <TextView android:id="@+id/nextTrackButton" android:layout_width="38dp"
                android:layout_height="44dp" android:gravity="center" android:text="▶|"
                android:textColor="#F3F6F3" android:textSize="17sp"
                android:clickable="true" android:focusable="true" android:contentDescription="Next song" />
            <TextView android:id="@+id/forwardButton" android:layout_width="46dp"
                android:layout_height="44dp" android:gravity="center" android:text="15↷"
                android:textColor="#ECF5E9" android:textSize="15sp"/>
            <TextView android:id="@+id/openButton" android:layout_width="32dp"
                android:layout_height="44dp" android:gravity="center" android:text="↗"
                android:textColor="#B2F369" android:textSize="22sp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/navigationBar" android:layout_width="match_parent"
        android:layout_height="61dp" android:orientation="horizontal" android:gravity="center"
        android:background="#131719" android:paddingStart="12dp" android:paddingEnd="12dp">
        <TextView android:id="@+id/homeTab" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="⌂  Home"
            android:textSize="14sp" android:textStyle="bold" android:textColor="#B2F369"
            android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/searchTab" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="⌕  Search"
            android:textSize="14sp" android:textColor="#A6B5AC"
            android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/libraryTab" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="▤  Library"
            android:textSize="14sp" android:textColor="#A6B5AC"
            android:clickable="true" android:focusable="true" />
    </LinearLayout>
</LinearLayout>
